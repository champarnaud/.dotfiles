" Retirer la compatibilité avec VI
set nocompatible

" ------------------------------------------------------------------------------
"  mapping de touches
" ------------------------------------------------------------------------------

" Caps lock > Escape
imap <F2> <Esc><CR>
" Barre espace > Page down
nmap <Space> <PageDown>

" Active la numérotation des lignes
set number

" Active les numéros de lignes relatif par rapport à la positoin actuel
set relativenumber

" Active la coloration syntaxique
syntax on

" Active l indentation syntaxique
set smartindent

" Show current mode
set showmode

" Show command being executed
set showcmd

" Always show status line
set laststatus=2
set statusline+=%F\ col:\ %4c\ line:\ %3l/%-3L

" Enhance command line completion
set wildmenu

" Allow mouse use in vim
set mouse=a

" Briefly show matching braces, parens, etc
set showmatch

" Enable line wrapping
set wrap

" Wrap on column 80
set textwidth=80

" Afficher le numéro de colonne dans la barre de statut
set ruler

" Afficher la position ligne:colonne en bas à droite

" Disable preview window on completion
set completeopt=longest,menuone

" Highlight current line
set cursorline

" Set the minimal amount of lignes under and above the cursor
" Useful for keeping context when moving with j/k
set scrolloff=5

" Use UTF-8 as the default text encoding
set encoding=utf-8

" Try to set right locale
try
	lang fr_FR
catch
endtry

" Indentation automatique
set autoindent

" Indentation intelligente
set smartindent

" Indentation
filetype indent on


" Tabulation = 4 espaces
set tabstop=4
set shiftwidth=4

" affichage des 80 colone
set colorcolumn=+1
" highlight ColorColumn ctermbg=grey

" thème
colors unokai

" ------------------------------------------------------------------------------
" Search options
" ------------------------------------------------------------------------------

" Ignore case on search
set ignorecase

" Ignore case unless there is an uppercase letter in the pattern
set smartcase

" Move cursor to the matched string
set incsearch


" ------------------------------------------------------------------------------
" Raccourci perso
" ------------------------------------------------------------------------------

" Correction d'indentation automatique < ;i >
nmap <silent> ;i gg=G

" Split screen horiz and vert, prompt for file, and open
" ala gosmacs visit-file or GNU find-file-other-window
map <C-X><C-V> :vsplit 
map <C-X><C-H> :sp 

" Sauvegarde avec Ctrl+s (Normal, Insert, Visual, etc.)
map <C-s> :w<CR>

" ------------------------------------------------------------------------------
" Highlight Unwanted Whitespace
" ------------------------------------------------------------------------------
highlight RedundantWhitespace ctermbg=green guibg=green
match RedundantWhitespace /\s\+$\| \+\ze\t/


" ------------------------------------------------------------------------------
" plug-in avec plug
" ------------------------------------------------------------------------------

" Install vim-plug if we don't already have it
" Credit to github.com/captbaritone
if empty(glob("~/.vim/autoload/plug.vim"))
    " Ensure all needed directories exist  (Thanks @kapadiamush)
    execute '!mkdir -p ~/.vim/plugged'
    execute '!mkdir -p ~/.vim/autoload'
    " Download the actual plugin manager
    execute '!curl -fLo ~/.vim/autoload/plug.vim https://raw.github.com/junegunn/vim-plug/master/plug.vim'
endif

" Installation de plug-in
call plug#begin()

" List your plugins here
"Plug 'tpope/vim-sensible'
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'sheerun/vim-polyglot'
Plug 'preservim/vim-markdown'

call plug#end()
